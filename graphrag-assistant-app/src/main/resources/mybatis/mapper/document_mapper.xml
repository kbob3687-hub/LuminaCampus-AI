<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.luminacampus.infrastructure.persistent.dao.IDocumentDao">

    <resultMap id="DocumentMap" type="com.luminacampus.infrastructure.persistent.po.DocumentPO">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="file_name" property="fileName"/>
        <result column="subject" property="subject"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="insert" parameterType="com.luminacampus.infrastructure.persistent.po.DocumentPO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO document (user_id, file_name, subject, status)
        VALUES (#{userId}, #{fileName}, #{subject}, #{status})
    </insert>

    <select id="queryByUserId" resultMap="DocumentMap">
        SELECT id, user_id, file_name, subject, status, create_time, update_time
        FROM document
        WHERE user_id = #{userId}
        ORDER BY create_time DESC
    </select>

</mapper>
