<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.luminacampus.infrastructure.persistent.dao.IConversationDao">

    <resultMap id="ConversationMap" type="com.luminacampus.infrastructure.persistent.po.ConversationPO">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="subject" property="subject"/>
        <result column="question" property="question"/>
        <result column="answer" property="answer"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="insert" parameterType="com.luminacampus.infrastructure.persistent.po.ConversationPO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO conversation (user_id, subject, question, answer)
        VALUES (#{userId}, #{subject}, #{question}, #{answer})
    </insert>

    <select id="queryByUserId" resultMap="ConversationMap">
        SELECT id, user_id, subject, question, answer, create_time
        FROM conversation
        WHERE user_id = #{userId}
        ORDER BY create_time DESC
    </select>

</mapper>
